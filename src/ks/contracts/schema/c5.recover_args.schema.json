{
  "$defs": {
    "ActionRef": {
      "additionalProperties": false,
      "description": "A recorded action, identified by its record.",
      "properties": {
        "action_id": {
          "description": "Its action id.",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Action Id",
          "type": "string"
        },
        "agent_id": {
          "description": "Attributed principal of that record.",
          "pattern": "^(?:ks\\.(?:gateway|monitor|operator|recovery|witness)|[a-z][a-z0-9_]{0,31})$",
          "title": "Agent Id",
          "type": "string"
        },
        "seq": {
          "description": "Record seq.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "agent_id",
        "seq"
      ],
      "title": "ActionRef",
      "type": "object"
    },
    "CancelOutboxStep": {
      "additionalProperties": false,
      "description": "Discard a held outbox item so it never leaves.",
      "properties": {
        "n": {
          "description": "Position in ``steps`` (0-based); steps run in this order.",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "const": "cancel_outbox",
          "default": "cancel_outbox",
          "description": "Step kind.",
          "title": "Op",
          "type": "string"
        },
        "outbox_id": {
          "description": "Held item to cancel.",
          "pattern": "^ob-[0-9]{6,16}$",
          "title": "Outbox Id",
          "type": "string"
        },
        "reason": {
          "description": "Short code, e.g. ``tainted_write``, ``tainted_read``, ``write_write_conflict``.",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "n",
        "op",
        "outbox_id",
        "reason"
      ],
      "title": "CancelOutboxStep",
      "type": "object"
    },
    "CompensateStep": {
      "additionalProperties": false,
      "description": "Run the registered opposite action for a class C effect.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionRef",
          "description": "Action being compensated."
        },
        "compensator": {
          "description": "Registered compensator name, e.g. ``tickets.close``.",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Compensator",
          "type": "string"
        },
        "n": {
          "description": "Position in ``steps`` (0-based); steps run in this order.",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "const": "compensate",
          "default": "compensate",
          "description": "Step kind.",
          "title": "Op",
          "type": "string"
        },
        "reason": {
          "description": "Short code, e.g. ``tainted_write``, ``tainted_read``, ``write_write_conflict``.",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "compensator",
        "n",
        "op",
        "reason"
      ],
      "title": "CompensateStep",
      "type": "object"
    },
    "FlagStep": {
      "additionalProperties": false,
      "description": "Hand to a person: no provable safe fix (write-write conflict, dispatched I1/I2 effect).",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Action concerned, if any."
        },
        "n": {
          "description": "Position in ``steps`` (0-based); steps run in this order.",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "obj": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,31}:[A-Za-z0-9_.-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Object concerned, if any.",
          "title": "Obj"
        },
        "op": {
          "const": "flag",
          "default": "flag",
          "description": "Step kind.",
          "title": "Op",
          "type": "string"
        },
        "reason": {
          "description": "Short code, e.g. ``tainted_write``, ``tainted_read``, ``write_write_conflict``.",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "n",
        "obj",
        "op",
        "reason"
      ],
      "title": "FlagStep",
      "type": "object"
    },
    "ReplanStep": {
      "additionalProperties": false,
      "description": "An LLM step that must be thought through again; queued for console approval. We build no re-planner.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionRef",
          "description": "Action whose output is tainted."
        },
        "n": {
          "description": "Position in ``steps`` (0-based); steps run in this order.",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "const": "replan",
          "default": "replan",
          "description": "Step kind.",
          "title": "Op",
          "type": "string"
        },
        "reason": {
          "description": "Short code, e.g. ``tainted_write``, ``tainted_read``, ``write_write_conflict``.",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "n",
        "op",
        "reason"
      ],
      "title": "ReplanStep",
      "type": "object"
    },
    "RerunStep": {
      "additionalProperties": false,
      "description": "Re-execute a deterministic honest action on repaired state; outbox dedupes on idempotency_key (M14).\n\nExecutes the original tool and args (side store, ARGS domain) for ``action.agent_id``/``action_id``.\nIdempotency keys derive from those, not from the ``ks.recovery`` envelope, so a re-run payment updates\nthe same ``outbox:<id>`` (v+1, back on hold). ``OutboxItem.author`` stays the original agent.\nRedacted args make the step a ``flag``.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionRef",
          "description": "Original action; the re-run derives the same idempotency keys."
        },
        "n": {
          "description": "Position in ``steps`` (0-based); steps run in this order.",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "const": "rerun",
          "default": "rerun",
          "description": "Step kind.",
          "title": "Op",
          "type": "string"
        },
        "reason": {
          "description": "Short code, e.g. ``tainted_write``, ``tainted_read``, ``write_write_conflict``.",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "n",
        "op",
        "reason"
      ],
      "title": "RerunStep",
      "type": "object"
    },
    "RestoreStep": {
      "additionalProperties": false,
      "description": "Taint-scoped revert of one object: write a new version equal to ``to`` (class R).",
      "properties": {
        "expect": {
          "$ref": "#/$defs/VersionRef",
          "description": "The culprit's after-version (B6). Must still be the head, otherwise the step fails closed\n(``hold/stale_plan``); an honest later write makes it a ``flag`` at plan time instead."
        },
        "n": {
          "description": "Position in ``steps`` (0-based); steps run in this order.",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "obj": {
          "description": "Object to restore.",
          "pattern": "^[a-z][a-z0-9_]{0,31}:[A-Za-z0-9_.-]{1,128}$",
          "title": "Obj",
          "type": "string"
        },
        "op": {
          "const": "restore",
          "default": "restore",
          "description": "Step kind.",
          "title": "Op",
          "type": "string"
        },
        "reason": {
          "description": "Short code, e.g. ``tainted_write``, ``tainted_read``, ``write_write_conflict``.",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Reason",
          "type": "string"
        },
        "to": {
          "$ref": "#/$defs/VersionRef",
          "description": "Pre-taint version whose value is re-written (value from the side store)."
        }
      },
      "required": [
        "expect",
        "n",
        "obj",
        "op",
        "reason",
        "to"
      ],
      "title": "RestoreStep",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "description": "A version plus the hash of its value (no raw value).",
      "properties": {
        "hash": {
          "description": "``value_hash(value)`` of that version; the value itself is in the side store.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "ver": {
          "description": "Version number.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Ver",
          "type": "integer"
        }
      },
      "required": [
        "hash",
        "ver"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "https://killswitch.local/schema/1.1.0/c5.recover_args.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Args of a ``ks.recover.<op>`` envelope: one step of an approved plan (G6).",
  "properties": {
    "n": {
      "description": "Step number; must be listed in the approval.",
      "minimum": 0,
      "title": "N",
      "type": "integer"
    },
    "plan_hash": {
      "description": "Must equal the approved ``plan_hash``.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "description": "Plan the step belongs to.",
      "pattern": "^p-[0-9]{6,16}$",
      "title": "Plan Id",
      "type": "string"
    },
    "step": {
      "description": "The step itself, identical to ``plan.steps[n]``.",
      "discriminator": {
        "mapping": {
          "cancel_outbox": "#/$defs/CancelOutboxStep",
          "compensate": "#/$defs/CompensateStep",
          "flag": "#/$defs/FlagStep",
          "replan": "#/$defs/ReplanStep",
          "rerun": "#/$defs/RerunStep",
          "restore": "#/$defs/RestoreStep"
        },
        "propertyName": "op"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RestoreStep"
        },
        {
          "$ref": "#/$defs/RerunStep"
        },
        {
          "$ref": "#/$defs/ReplanStep"
        },
        {
          "$ref": "#/$defs/CancelOutboxStep"
        },
        {
          "$ref": "#/$defs/CompensateStep"
        },
        {
          "$ref": "#/$defs/FlagStep"
        }
      ],
      "title": "Step"
    }
  },
  "required": [
    "n",
    "plan_hash",
    "plan_id",
    "step"
  ],
  "title": "RecoverArgs",
  "type": "object"
}

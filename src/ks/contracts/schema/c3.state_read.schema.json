{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://killswitch.local/schema/1.6.0/c3.state_read.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result of ``StateView.get``: ``(value, ver, author)``. Holds a RAW value: never put it in a record.",
  "properties": {
    "author": {
      "description": "Principal whose recorded action wrote this version.",
      "pattern": "^(?:ks\\.(?:gateway|monitor|operator|recovery|witness)|[a-z][a-z0-9_]{0,31})$",
      "title": "Author",
      "type": "string"
    },
    "hash": {
      "description": "``value_hash(value)``.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hash",
      "type": "string"
    },
    "obj": {
      "description": "Object id.",
      "pattern": "^[a-z][a-z0-9_]{0,31}:[A-Za-z0-9_.-]{1,128}$",
      "title": "Obj",
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/JsonValue",
      "description": "Raw current value (``None`` = deleted). Gateway-internal only."
    },
    "ver": {
      "description": "Current version.",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Ver",
      "type": "integer"
    }
  },
  "required": [
    "author",
    "hash",
    "obj",
    "value",
    "ver"
  ],
  "title": "StateRead",
  "type": "object"
}

  "meetings": [
    {
      "id": "CALL-01",
      "title": "Call #1 — Research readout and decisions",
      "date": "19 Nov 2026",
      "attendees": [
        "pmo",
        "maya",
        "anaya",
        "kabir",
        "zoya",
        "panel"
      ],
      "summary": "Research confirms that undo is a dependency problem. Airlock already does forward containment; our niche is the backward half (revert one agent's landed writes, repair their readers), an authenticated record, and oracle-scored recovery. All 13 open questions resolved; Sprint 2 opened.",
      "decisions": [
        "Headline layered: problem = undo breaks once others read the bad write; fix = provenance; payoff = selective undo; why = testimony vs evidence (Aarav to confirm)",
        "Own row-versioned SQLite store; Dolt only as the production twin",
        "Re-run deterministic steps through the outbox with idempotency keys; LLM steps become approval-gated re-plan items",
        "Tamper-evident up to the last witnessed head: hash chain + two signatures + separate witness + verify",
        "A bad signature suspends the connection, never the claimed agent",
        "Hold per action, using only recorded read sets",
        "Gateway is the scheduler (tick barrier) so runs are deterministic and recovery scores reproduce",
        "Hero scenario F2+: supplier IBAN swap → billing/payments/comms; triage conflict; inventory/docs independent"
      ],
      "next": [
        "Abstract Kit for Aarav (fact card, guardrails, diagram, term lock, jury Q&A)",
        "Contracts C1–C6, then ADR-00…07",
        "Threat model + red-team spec",
        "Walking skeleton with the determinism test"
      ]
    },
    {
      "id": "CALL-02",
      "title": "Call #2 — Design freeze",
      "date": "19 Nov 2026",
      "attendees": [
        "pmo",
        "maya",
        "kabir",
        "anaya",
        "vikram",
        "panel"
      ],
      "summary": "All eight ADRs came back from review with real holes. One binding resolution per item (A–N) was adopted with nine amendments. Contracts move to v1.1.0. Build starts as soon as CON-02 lands.",
      "decisions": [
        "Hero: sensitive fields become their own versioned objects. IBAN and price restored; triage's edit kept; no flags (Aarav to confirm)",
        "Honest conflict kept in bench variant F2+x (R>0) and culprit-window variant F2+c (C>0)",
        "S*: same seed with the fault off; the culprit also stops from its suspension tick; baselines labelled oracle-assisted",
        "root_candidates[0] = writer of the bad version; read-only links never auto-suspend",
        "Epochs strictly increase; release always issues a fresh epoch; max expiry 8 ticks",
        "Run anchor (head, count, keyring hash, config hash) checked by ks verify --head",
        "Field-level reads recorded; the agent's view joins its read set",
        "Operator signer renamed ks.operator; root-only socket checked by peer credentials"
      ],
      "next": [
        "CON-02 contracts v1.1.0",
        "ADR amendments by all owners",
        "Abstract kit updates for the new D13 wording",
        "Sprint 3 build"
      ]
    },
    {
      "id": "CALL-03",
      "title": "Call #3 — Sprint 3 build kickoff",
      "date": "19 Nov 2026",
      "attendees": [
        "pmo",
        "maya",
        "panel",
        "kabir",
        "vikram"
      ],
      "summary": "The walking skeleton held up: the Panel ran 40 tamper cases and a real rogue agent, and found two bugs. A plan of 37 issues was adopted, with the hero path due green on 24 Nov and code freeze on 26 Nov.",
      "decisions": [
        "Build plan B3-01…B3-35 adopted, plus B3-36 (Panel M1/M2 fixes) and B3-37 (refactor seams)",
        "Contracts 1.2 is additive only; isolation mode is recorded so a degraded run can never verify as fully isolated",
        "Critical path: state → taint → planner → re-run simulation → hero end to end (24 Nov)",
        "Slip rule: Maya pairs on re-run simulation if it isn't green by 24 Nov 18:00"
      ],
      "next": [
        "Day 1: contracts 1.2, state store, detectors",
        "Then B3-36/B3-37 before gateway work starts"
      ]
    }
  ],
  "decisions": [
    {
      "id": "D-01",
      "title": "Rollback is a dependency problem, not a snapshot problem",
      "status": "confirmed",
      "summary": "Confirmed by RES-01/02/04/06. Two claims killed: 'nobody has provenance containment' and 'nobody has agent undo'."
    },
    {
      "id": "D-02",
      "title": "Layered headline: dependency gap → provenance → selective undo",
      "status": "awaiting Aarav",
      "summary": "Problem first (organisers' order); provenance as the fix; selective undo as the demo payoff; testimony vs evidence as why it matters."
    },
    {
      "id": "D-03",
      "title": "Own row-versioned SQLite store",
      "status": "accepted",
      "summary": "Dolt never run and outside our dependency list; shown as the production twin."
    },
    {
      "id": "D-04",
      "title": "Re-run deterministic, re-plan LLM with approval",
      "status": "accepted",
      "summary": "LLM replay does not transfer (RES-01). Re-runs go through the outbox, deduplicated by idempotency key."
    },
    {
      "id": "D-05",
      "title": "Tamper-evident to last witnessed head",
      "status": "accepted",
      "summary": "Hash chain, agent and gateway signatures, separate witness process, verify CLI. Never 'tamper-proof'."
    },
    {
      "id": "D-06",
      "title": "Bad signature suspends the connection, not the claimed agent",
      "status": "accepted",
      "summary": "Stops forgers from framing honest agents (Kabir)."
    },
    {
      "id": "D-07",
      "title": "Per-action lineage hold from recorded read sets",
      "status": "accepted",
      "summary": "Independent work keeps running; agent-declared lineage is never trusted."
    },
    {
      "id": "D-08",
      "title": "Gateway is the scheduler (tick barrier)",
      "status": "accepted",
      "summary": "Same seed → byte-identical records, so oracle scores reproduce for the jury."
    },
    {
      "id": "D-09",
      "title": "Honest-claims rules for the abstract",
      "status": "accepted",
      "summary": "No 'first', no Airlock comparison, no 'tamper-proof'/'compliant', Who&When quoted with its setting, our numbers labelled targets."
    },
    {
      "id": "D-10",
      "title": "Hero uses field-level objects for sensitive fields",
      "status": "awaiting Aarav",
      "summary": "Restores the swapped IBAN and price without touching triage's honest edit. Honest conflicts are kept in variants F2+x and F2+c."
    },
    {
      "id": "D-11",
      "title": "Revised D13 target wording",
      "status": "awaiting Aarav",
      "summary": "R=0 and C=0 on the hero as targets. Honest later edits go to a person and count in R. The culprit's own window counts in C."
    },
    {
      "id": "D-12",
      "title": "Root candidate = writer of the bad version",
      "status": "accepted",
      "summary": "Stops a rogue framing an honest upstream agent by reading its data first."
    },
    {
      "id": "D-13",
      "title": "Start the build ahead of the official prototyping window",
      "status": "accepted",
      "summary": "Recovery modules are estimated at 9.5 build days against an 8-day window."
    },
    {
      "id": "D-14",
      "title": "ADR word cap waived after the freeze (≤1,500 words)",
      "status": "accepted",
      "summary": "Post-freeze ADRs carry their amendments in place. Length alone is not a defect; reviewers judge correctness. ADR-06-metrics.md is an intentional companion file."
    },
    {
      "id": "D-15",
      "title": "Seed record (seq 1) gets its own system tool ks.seed",
      "status": "decided",
      "summary": "The frozen system-tool list (CALL-02 G1) has no seed tool, so B3-11 records the seed as ks.dispatch, which G4 reserves for outbox dispatch. Maya recommends adding ks.seed (contracts 1.3, additive, signed by ks.gateway only, valid only at seq 1, tick 0). Until then the seed stays ks.dispatch with policy_rule gateway.seed. DECIDED by Aarav 19 Nov: add ks.seed (contracts 1.3, additive; amends CALL-02 G1). Owner maya (B3-43), then nisha switches the seed write."
    },
    {
      "id": "D-16",
      "title": "B2 amended: reporter is independent in the hero (not re-run)",
      "status": "decided",
      "summary": "DECIDED by Aarav 20 Nov: on real runs reporter never read a tainted invoice before suspend (vikram's B3-27 finding, seeds 1/2/3/5), so conservative taint leaves it alone. CALL-02 B2-a amendment; demo diff and golden follow taint."
    },
    {
      "id": "D-17",
      "title": "R=0 claims state operator releases",
      "status": "decided",
      "summary": "DECIDED by Aarav 20 Nov: every R=0 claim says it holds after the operator released N held items (seed 2: 9, of which 7 honest). score.json reports fp_cost.operator_unholds and held_honest_actions."
    }
  ],
